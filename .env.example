# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://my-applet-url.run.app"

# -----------------------------------------------------------------
# OMNISEND MESSAGING GATEWAY SECRETS
# Configure these environment variables on your server or via AI Studio secrets.
# Do NOT commit real tokens directly to source code repositories.
# -----------------------------------------------------------------

# Facebook Messenger Graph API v19.0 Secrets
FB_MESSENGER_PAGE_ACCESS_TOKEN=""
FB_MESSENGER_PAGE_ID=""
FB_MESSENGER_VERIFY_TOKEN="omnisend_verify_token_2026"

# Slack Incoming Webhook Secrets
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""

# Telegram Bot API Secrets
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Business API Secrets
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Twilio SMS Gateway Secrets
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
